<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
    <Version>1.0.0</Version>
    <Authors>ZVT2SumUp contributors</Authors>
    <Product>ZVT2SumUp</Product>
    <Description>Native Windows payment gateway connecting ZVT 13.13 point-of-sale systems with SumUp terminals.</Description>
    <PackageTags>zvt;zvt-13-13;sumup;korona;payment-gateway;pos;point-of-sale;payment-terminal;sumup-solo;windows;winforms;windows-service;dotnet;csharp;tcp;serial-port;com-port;self-contained</PackageTags>
  </PropertyGroup>
</Project>
